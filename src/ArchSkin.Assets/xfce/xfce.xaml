<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PanelBackground">#1e1e1e</Color>
    <Color x:Key="PanelForeground">#d8d8d8</Color>
    <Color x:Key="DesktopBackground">#2a2a2a</Color>
    <Color x:Key="AccentColor">#4a7cbf</Color>
    <Color x:Key="AccentHover">#5a8ccf</Color>
    <Color x:Key="AccentPressed">#3a5a8a</Color>
    <Color x:Key="WindowBackground">#1e1e1e</Color>
    <Color x:Key="WindowForeground">#d8d8d8</Color>
    <Color x:Key="ControlBackground">#2a2a2a</Color>
    <Color x:Key="ControlForeground">#d8d8d8</Color>
    <Color x:Key="ControlBorder">#3a3a3a</Color>
    <Color x:Key="ControlHoverBackground">#3a3a3a</Color>
    <Color x:Key="ControlPressedBackground">#4a7cbf</Color>
    <Color x:Key="ButtonBackground">#4a7cbf</Color>
    <Color x:Key="ButtonForeground">#ffffff</Color>
    <Color x:Key="ButtonHoverBackground">#5a8ccf</Color>
    <Color x:Key="ButtonPressedBackground">#3a5a8a</Color>
    <Color x:Key="ListBackground">#1e1e1e</Color>
    <Color x:Key="ListForeground">#d8d8d8</Color>
    <Color x:Key="ListSelectedBackground">#4a7cbf</Color>
    <Color x:Key="ListSelectedForeground">#ffffff</Color>
    <Color x:Key="ListHoverBackground">#3a3a3a</Color>
    <Color x:Key="FocusBorder">#4a7cbf</Color>
    <Color x:Key="ErrorColor">#e84e4e</Color>
    <Color x:Key="SuccessColor">#5fc860</Color>
    <Color x:Key="WarningColor">#f9c03f</Color>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="{StaticResource PanelForeground}"/>
    <SolidColorBrush x:Key="DesktopBackgroundBrush" Color="{StaticResource DesktopBackground}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForeground}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackground}"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource ControlForeground}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorder}"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="{StaticResource ControlHoverBackground}"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="{StaticResource ControlPressedBackground}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackground}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForeground}"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{StaticResource ButtonHoverBackground}"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{StaticResource ButtonPressedBackground}"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="{StaticResource ListBackground}"/>
    <SolidColorBrush x:Key="ListForegroundBrush" Color="{StaticResource ListForeground}"/>
    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="{StaticResource ListSelectedBackground}"/>
    <SolidColorBrush x:Key="ListSelectedForegroundBrush" Color="{StaticResource ListSelectedForeground}"/>
    <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="{StaticResource ListHoverBackground}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorder}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#ffffff"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#5a8ccf"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#3a5a8a"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#d8d8d8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#2a2a2a"/>
        <Setter Property="Foreground" Value="#d8d8d8"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="#4a7cbf"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#2a2a2a"/>
        <Setter Property="Foreground" Value="#d8d8d8"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="#1e1e1e"/>
        <Setter Property="Foreground" Value="#d8d8d8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
</ResourceDictionary>