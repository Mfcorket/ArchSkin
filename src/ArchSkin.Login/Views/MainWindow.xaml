<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ArchSkin.Login.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1e1e2e">
        <Border MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" Background="#313244" CornerRadius="16" BorderBrush="#4c566a" BorderThickness="1">
            <StackPanel Spacing="24">
                <TextBlock Text="ArchSkin" FontSize="32" FontWeight="Light" Foreground="#cdd6f4" HorizontalAlignment="Center"/>
                <TextBlock Text="Sign in to your session" FontSize="14" Foreground="#a6adc8" HorizontalAlignment="Center"/>

                <StackPanel x:Name="UserSelection" Spacing="12">
                    <Button x:Name="UserButton"
                            Content="User"
                            FontSize="16"
                            Padding="20,12"
                            HorizontalAlignment="Stretch"
                            Background="#45475a"
                            Foreground="#cdd6f4"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="OnUserClick"/>
                </StackPanel>

                <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Spacing="12">
                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Password"
                                 FontSize="16"
                                 Padding="16,12"
                                 Background="#1e1e2e"
                                 Foreground="#cdd6f4"
                                 BorderBrush="#4c566a"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 PasswordChar="•"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="Cancel"
                                Click="OnCancelClick"
                                Background="Transparent"
                                Foreground="#a6adc8"
                                BorderThickness="1"
                                BorderBrush="#4c566a"
                                Padding="16,8"
                                CornerRadius="8"/>
                        <Button Content="Sign In"
                                Click="OnSignInClick"
                                Background="#89b4fa"
                                Foreground="#1e1e2e"
                                BorderThickness="0"
                                Padding="24,8"
                                CornerRadius="8"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#f38ba8"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>