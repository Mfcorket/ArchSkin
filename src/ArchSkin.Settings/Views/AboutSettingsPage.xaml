<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Settings.Views.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock Text="ArchSkin" FontSize="32" FontWeight="Light" Foreground="#eceff4"/>
        <TextBlock Text="Version 1.0.0" FontSize="16" Foreground="#88c0d0"/>
        <TextBlock Text="Give your Windows an Arch-grade look." FontSize="14" Foreground="#d8dee9" Margin="0,8,0,0"/>

        <TextBlock Text="ArchSkin is a Windows-native desktop shell that visually and behaviorally replicates an Arch Linux desktop experience (GNOME-style) using C# + WinUI 3."
                   TextWrapping="Wrap" Foreground="#d8dee9" Margin="0,16,0,0"/>

        <TextBlock Text="License: MIT" FontSize="14" Foreground="#d8dee9" Margin="0,16,0,0"/>
        <TextBlock Text="ArchSkin is not affiliated with, endorsed by, or sponsored by Arch Linux."
                   TextWrapping="Wrap" Foreground="#9aa5b1" FontSize="12"/>
    </StackPanel>
</UserControl>
