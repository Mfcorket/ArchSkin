<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Settings.Views.ThemeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <TextBlock Text="Theme" FontSize="24" FontWeight="Light" Foreground="#eceff4"/>
        <TextBlock Text="Choose your desktop theme" FontSize="14" Foreground="#88c0d0"/>

        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
            <Border x:Name="PreviewBorder" Width="300" Height="180" CornerRadius="8" Background="#2e3440" BorderBrush="#4c566a" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <Grid x:Name="PreviewFallback" Background="#3b4252">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="PreviewThemeName" Text="Select a theme" FontSize="16" Foreground="#88c0d0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PreviewDescription" Text="Choose a theme to preview" FontSize="12" Foreground="#9aa5b1" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Width="240" Spacing="12">
                <TextBlock Text="Available Themes" FontSize="16" FontWeight="SemiBold" Foreground="#eceff4"/>
                <ListView x:Name="ThemeList" SelectionMode="Single" SelectionChanged="OnThemeSelectionChanged" Height="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#3b4252" Padding="12" CornerRadius="6" Margin="0,0,0,4">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ThemeNameText" FontSize="14" FontWeight="SemiBold" Foreground="#eceff4"/>
                                    <TextBlock x:Name="ThemeDescText" FontSize="11" Foreground="#88c0d0"/>
                                    <TextBlock x:Name="ThemeLicenseText" FontSize="10" Foreground="#9aa5b1"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="ApplyThemeButton" Content="Apply Theme" Click="OnApplyThemeClick" IsEnabled="False" Background="#3daee9" Foreground="White" Padding="24,10" FontSize="13"/>
            <Button Content="Install Theme" Click="OnInstallThemeClick" Background="Transparent" Foreground="#88c0d0" BorderBrush="#4c566a" BorderThickness="1" Padding="16,8"/>
            <Button Content="Verify Licenses" Click="OnVerifyClick" Background="Transparent" Foreground="#88c0d0" BorderBrush="#4c566a" BorderThickness="1" Padding="16,8"/>
        </StackPanel>
    </StackPanel>
</UserControl>