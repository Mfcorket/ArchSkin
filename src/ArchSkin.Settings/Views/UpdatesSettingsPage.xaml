<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Settings.Views.UpdatesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <TextBlock Text="Automatic Updates" FontSize="18" FontWeight="SemiBold"/>
        <ToggleSwitch x:Name="AutoUpdate" Header="Check for updates automatically" Toggled="OnSettingChanged"/>
        <Slider x:Name="UpdateFrequency" Header="Check frequency (hours)" Minimum="1" Maximum="168" StepFrequency="1" ValueChanged="OnSettingChanged"/>

        <TextBlock Text="Crash Reporting" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <ToggleSwitch x:Name="CrashReporting" Header="Send anonymous crash reports" Toggled="OnSettingChanged"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="View crash reports" Click="OnClickViewCrashReports" Padding="16,8"/>
        </StackPanel>

        <TextBlock Text="Actions" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <Button Content="Check for Updates Now" Click="OnClickCheckUpdates" Padding="16,8"/>
    </StackPanel>
</UserControl>
