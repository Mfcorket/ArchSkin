<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Settings.Views.WallpaperSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <TextBlock Text="Current Wallpaper" FontSize="18" FontWeight="SemiBold"/>
        <Border Background="#3b4252" Padding="20" CornerRadius="8" HorizontalAlignment="Left">
            <TextBlock x:Name="CurrentWallpaper" Text="System default" Foreground="#eceff4"/>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Choose Image..." Click="OnClickChooseImage"/>
            <Button Content="Reset to Default" Click="OnClickReset"/>
        </StackPanel>
    </StackPanel>
</UserControl>
