<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Shell.Views.LauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#2e3440" Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MaxWidth="600" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search applications..."
                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18"
                     Padding="12,8"/>

            <Button Grid.Column="1"
                    Content="Close"
                    Margin="8,0,0,0"
                    Click="OnCloseClick"/>
        </Grid>

        <GridView x:Name="AppsGrid"
                  Grid.Row="1"
                  Margin="0,24,0,0"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnAppClick">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="110" Margin="8" Spacing="6">
                        <TextBlock Text="&#xE71D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="40"
                                   Foreground="#88c0d0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="#eceff4"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>
