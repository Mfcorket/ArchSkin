<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Shell.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#2e3440" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Activities"
                   FontSize="32"
                   FontWeight="Light"
                   Foreground="#eceff4"
                   Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="WorkspaceList"
                      Grid.Column="0"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnWorkspaceClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="WorkspaceBorder"
                                Background="#3b4252"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                CornerRadius="8">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#eceff4"
                                       FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <ListView x:Name="WindowsList"
                      Grid.Column="1"
                      Margin="16,0,0,0"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnWindowClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3b4252" Padding="20" Margin="0,0,0,8" CornerRadius="8">
                            <TextBlock Text="{Binding WindowTitle}" Foreground="#eceff4" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Button Grid.Row="2"
                Content="Close Overview"
                HorizontalAlignment="Center"
                Click="OnCloseClick"/>
    </Grid>
</UserControl>