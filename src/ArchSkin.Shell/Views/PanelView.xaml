<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArchSkin.Shell.Views.PanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#2e3440" Height="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
            <Button x:Name="ActivitiesButton"
                    Content="Activities"
                    Foreground="#eceff4"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Padding="12,0"
                    Click="OnActivitiesClick"/>
            <Button x:Name="AppsButton"
                    Content="Apps"
                    Foreground="#eceff4"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Padding="12,0"
                    Click="OnAppsClick"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <TextBlock x:Name="ClockText"
                       Text="12:00"
                       Foreground="#eceff4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Tapped="OnClockTapped"/>
            <Popup x:Name="QuickSettingsPopup" IsLightDismissEnabled="True">
                <Border Background="#2e3440" BorderBrush="#4c566a" BorderThickness="1" CornerRadius="8" Padding="16" Width="320">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Quick Settings" FontSize="16" FontWeight="SemiBold" Foreground="#eceff4"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Brightness" FontSize="13" Foreground="#eceff4"/>
                            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="80" StepFrequency="5" ValueChanged="OnBrightnessChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Volume" FontSize="13" Foreground="#eceff4"/>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50" StepFrequency="5" ValueChanged="OnVolumeChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Network" FontSize="13" Foreground="#eceff4"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleSwitch x:Name="NetworkToggle" Header="Wi-Fi" IsOn="True" Toggled="OnNetworkToggled"/>
                                <Button Content="Network Settings" Click="OnNetworkSettingsClick" FontSize="12" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#3b4252" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel>
                                    <TextBlock Text="Battery" FontSize="11" Foreground="#88c0d0"/>
                                    <TextBlock x:Name="BatteryPercent" Text="80%" FontSize="14" FontWeight="SemiBold" Foreground="#eceff4"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Performance" FontSize="11" Foreground="#88c0d0"/>
                                    <TextBlock Text="Balanced" FontSize="14" FontWeight="SemiBold" Foreground="#eceff4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SettingsButton"
                                Content="ArchSkin Settings"
                                Click="OnSettingsClick"
                                HorizontalAlignment="Stretch"
                                Background="#5e81ac"
                                Foreground="#eceff4"
                                BorderThickness="0"
                                Padding="12,8"
                                FontSize="13"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Column="2">
            <StackPanel x:Name="SystemTrayArea" Orientation="Horizontal" Spacing="10" Padding="12,0">
                <TextBlock x:Name="NetworkIcon"
                           Text="&#xE701;"
                           Foreground="#eceff4"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VolumeIcon"
                           Text="&#xE767;"
                           Foreground="#eceff4"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryIcon"
                           Text="&#xE8BF;"
                           Foreground="#eceff4"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryText"
                           Text="100%"
                           Foreground="#eceff4"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>